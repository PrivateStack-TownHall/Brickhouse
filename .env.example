# Optional server-side Git Personal Access Tokens (PATs).
# Copy this file to `.env` or `.env.local` (gitignored) so the local Vite proxy
# attaches your token on the server side without exposing it to the browser.
#
# Provider-wide tokens:
# BRICKHOUSE_GITHUB_TOKEN=
# BRICKHOUSE_GITLAB_TOKEN=
# BRICKHOUSE_BITBUCKET_TOKEN=
#
# Optional organization/user-specific overrides (uppercase, non-alphanumeric as _):
# BRICKHOUSE_GITHUB_TOKEN_PRIVATESTACK_TOWNHALL=
# BRICKHOUSE_GITHUB_TOKEN_VINCENT_GUIZOT=
